# Copy to .env and fill in. This file is the single source of truth for
# backend config; the frontend only reads NEXT_PUBLIC_API_URL (below).

# --- Anthropic ---
ANTHROPIC_API_KEY=

CLAUDE_PLANNER_MODEL=claude-sonnet-4-5
CLAUDE_RESEARCHER_MODEL=claude-sonnet-4-5
CLAUDE_SYNTHESIZER_MODEL=claude-opus-4-5

# --- Backend server ---
ARA_HOST=0.0.0.0
ARA_PORT=8000
ARA_CORS_ORIGINS=http://localhost:3000

# --- Researcher guardrails ---
ARA_RESEARCHER_MAX_ITERATIONS=5
ARA_RESEARCHER_INPUT_TOKEN_BUDGET=100000

# --- SSE ring buffer (events retained per report for reconnect) ---
ARA_EVENT_BUFFER_SIZE=50

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
