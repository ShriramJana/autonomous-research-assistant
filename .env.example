# Copy to .env and fill in. This file is the single source of truth for
# backend config. The frontend hits the backend via the Next.js /api/:path*
# rewrite (see frontend/next.config.ts), so no NEXT_PUBLIC_API_URL is needed —
# everything is same-origin to the browser.

# --- Anthropic ---
ANTHROPIC_API_KEY=
CLAUDE_PLANNER_MODEL=claude-sonnet-4-5
CLAUDE_RESEARCHER_MODEL=claude-sonnet-4-5
CLAUDE_SYNTHESIZER_MODEL=claude-opus-4-5

# --- Backend server ---
ARA_HOST=0.0.0.0
ARA_PORT=8000
ARA_CORS_ORIGINS=http://localhost:3000

# --- Researcher guardrails ---
ARA_RESEARCHER_MAX_ITERATIONS=5
ARA_RESEARCHER_INPUT_TOKEN_BUDGET=100000

# --- SSE ring buffer (events retained per report for reconnect) ---
ARA_EVENT_BUFFER_SIZE=50

# --- Supabase (auth + persistence) ---
# Project URL (used for both Postgres + JWKS public-key fetch).
SUPABASE_URL=https://your-project.supabase.co
# Postgres connection string. Use Session Pooler (IPv4) for compatibility.
SUPABASE_DB_URL=postgresql://postgres.<ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres
# Your auth.users.id — fill in after first sign-in to enable admin gallery promotion.
ADMIN_USER_ID=

# Frontend Supabase client (publishable key; safe to expose in browser).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# --- Free tier ---
FREE_TIER_PER_USER_MONTHLY=3
FREE_TIER_GLOBAL_CAP_USD=20.0
